{
  "name": "hyperion-studio-os-vscode",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "description": "Hyperion Studio OS — Chạy trực tiếp trên VS Code / Antigravity (Ubuntu Linux & Windows) kết nối gói Google AI Ultra (25.000 Credits) qua Local Bridge",
  "scripts": {
    "postinstall": "node scripts/setup-cross-platform.mjs",
    "setup": "node scripts/setup-cross-platform.mjs",
    "chrome": "node scripts/launch-chrome-flow.mjs",
    "bridge": "node flow-ultra-bridge.mjs",
    "produce": "node --experimental-strip-types vscode-cli-producer.ts",
    "skill:movie": "node --experimental-strip-types .agents/skills/ai-film-studio/scripts/run-full-movie-pipeline.ts",
    "skill:storyboard": "node --experimental-strip-types .agents/skills/ai-film-studio/scripts/run-full-movie-pipeline.ts --frames-only",
    "create-character": "node --experimental-strip-types vscode-cli-producer.ts --create-character",
    "create-scene": "node --experimental-strip-types vscode-cli-producer.ts --create-scene",
    "remaster": "node --experimental-strip-types scripts/remaster-run.ts",
    "test:premium": "node --experimental-strip-types scripts/test-premium-engine.ts && node --experimental-strip-types scripts/test-premium-shot-production.ts",
    "test:premium:engine": "node --experimental-strip-types scripts/test-premium-engine.ts",
    "test:premium:shots": "node --experimental-strip-types scripts/test-premium-shot-production.ts",
    "dev:ui": "vite",
    "build": "vite build",
    "proto:keyframes": "node --experimental-strip-types scripts/premium-proto/proto_stage123.ts",
    "proto:render": "node --experimental-strip-types scripts/premium-proto/proto_stage47.ts",
    "proto:master": "node --experimental-strip-types scripts/premium-proto/proto_master.ts",
    "proto:audio": "node --experimental-strip-types scripts/premium-proto/proto_audio.ts",
    "proto:stage-plate": "node --experimental-strip-types scripts/premium-proto/proto_stage_plate.ts",
    "proto:mix": "python scripts/premium-proto/proto_music_mix.py"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
